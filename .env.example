# Variables de entorno para ONDA Radio
# Copiar este archivo a .env y completar con tus valores

# Last.fm API Key (obtener en https://www.last.fm/api/account/create)
VITE_LASTFM_API_KEY=tu_api_key_aqui

# ACRCloud - Identificación de canciones (obtener en https://console.acrcloud.com)
ACR_ACCESS_KEY=tu_access_key_aqui
ACR_ACCESS_SECRET=tu_access_secret_aqui
ACR_HOST=identify-eu-west-1.acrcloud.com

# Google Sheets Webhook URL (Apps Script web app URL)
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/tu_script_id/exec
